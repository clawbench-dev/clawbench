/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# 图片文件名不带内容哈希，靠"永不原地改图、只换新文件名"维持长缓存。
# 真要替换某张图，请改名，否则已缓存的客户端一年内看不到新图。
/img/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=604800

/js/*
  Cache-Control: public, max-age=604800

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# 手册站（/docs/）单独一档：截图文件名会随功能更新被原地覆盖
# （docs/user-guide/screenshots/ 是同一批文件名重拍），所以不能像 /img/*
# 那样 immutable 缓存一年，否则改完手册老访客看不到新图。
# 规则靠下者优先，HTML 的 must-revalidate 必须写在 /docs/* 后面。
/docs/*
  Cache-Control: public, max-age=3600

/docs/*.html
  Cache-Control: public, max-age=0, must-revalidate
