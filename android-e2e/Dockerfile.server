# The REAL clawbench server for Tier 2 (h2 stream tunnel).
#
# Why a real server and not the Tier 1 mock: MockWebServer / the dependency-free
# mock are HALF-DUPLEX — they consume the whole request body before writing a
# response. The tunnel is full-duplex by construction (request body carries
# client->server bytes while the response body carries server->client bytes on
# the same stream), so only a real server can exercise it. See
# docs/plans/2026-09-25-h2-tunnel-implementation.md, T14.
#
# The binary is built by scripts/prepare-assets.sh and staged into
# android-e2e/assets/ because bind mounts do not resolve against this
# environment's host docker daemon — `docker build` streams the context from the
# client instead.
#
# It is a CGO_ENABLED=0 static build so it runs on a minimal base. The base is
# node:20-alpine only because that image is already loaded locally (Docker Hub is
# unreachable here); the Go binary itself needs no runtime.
FROM node:20-alpine

WORKDIR /app

# The real server + its config. config/config.yaml is resolved by
# platform.FindConfigPath: <data-dir>/config/config.yaml first, then the
# CWD-relative config/config.yaml — both are satisfied here.
COPY assets/clawbench-server /app/clawbench
COPY server-config/config.yaml /app/config/config.yaml

# data-dir holds the SQLite DB and logs. It is a plain directory inside the
# container: the harness tears the container down each run, so a fresh data dir
# is exactly the first-launch state the login path expects.
RUN chmod 0755 /app/clawbench && mkdir -p /data

EXPOSE 20000

# --data-dir must match the config search path above. The port comes from
# server-config/config.yaml (20000), so no --port flag is passed.
CMD ["/app/clawbench", "--data-dir", "/data"]
