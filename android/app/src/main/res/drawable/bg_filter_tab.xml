<?xml version="1.0" encoding="utf-8"?>
<!-- Tab style filter: activated = bottom accent line, default = bottom dim line — flat sharp style -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <layer-list>
            <item android:top="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
            <item android:gravity="bottom" android:height="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#58a6ff" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
            <item android:gravity="bottom" android:height="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#30363d" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
