<?xml version="1.0" encoding="utf-8"?>
<!-- Transparent 1x1 pixel — used as windowSplashScreenAnimatedIcon to hide
     the default square launcher icon from the Android 12+ system splash screen.
     The system splash will show only the solid background color,
     seamlessly transitioning to our native splash overlay with circular logo. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size android:width="1dp" android:height="1dp" />
</shape>
