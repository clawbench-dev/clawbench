<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-style action button: default = dark fill + border, pressed = lighter -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#2D333B" />
            <corners android:radius="4dp" />
            <stroke android:width="1dp" android:color="#444C56" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#21262D" />
            <corners android:radius="4dp" />
            <stroke android:width="1dp" android:color="#30363D" />
        </shape>
    </item>
</selector>
