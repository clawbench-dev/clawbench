<?xml version="1.0" encoding="utf-8"?>
<!-- System splash screen icon (Android 12+).
     Circular logo on dark background, matching the native splash overlay.
     The system enforces a circular mask on this drawable automatically. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/colorPrimary" />
        </shape>
    </item>
    <item
        android:width="72dp"
        android:height="72dp"
        android:drawable="@mipmap/ic_launcher"
        android:gravity="center" />
</layer-list>
