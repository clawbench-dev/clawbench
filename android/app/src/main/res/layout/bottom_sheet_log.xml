<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/browser_toolbar_bg"
    android:minHeight="300dp">

    <!-- Drag handle -->
    <View
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:background="@color/browser_url_hint_color" />

    <!-- Header: title + filter chips + clear -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/browser_log_title"
            android:textColor="@color/browser_url_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/filterAll"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/browser_log_filter_all"
            android:textColor="@color/browser_icon_tint"
            android:textSize="12sp"
            android:background="@drawable/bg_toolbar_btn"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/filterError"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginStart="4dp"
            android:text="@string/browser_log_filter_error"
            android:textColor="#f85149"
            android:textSize="12sp"
            android:background="@drawable/bg_toolbar_btn"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/filterWarn"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginStart="4dp"
            android:text="@string/browser_log_filter_warn"
            android:textColor="#d29922"
            android:textSize="12sp"
            android:background="@drawable/bg_toolbar_btn"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/filterLog"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginStart="4dp"
            android:text="@string/browser_log_filter_log"
            android:textColor="@color/browser_icon_tint"
            android:textSize="12sp"
            android:background="@drawable/bg_toolbar_btn"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnClearLog"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginStart="8dp"
            android:text="@string/browser_log_clear"
            android:textColor="@color/browser_icon_tint"
            android:textSize="12sp"
            android:background="@drawable/bg_toolbar_btn"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Search bar -->
    <EditText
        android:id="@+id/logSearchInput"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_url_bar"
        android:hint="@string/browser_log_search_hint"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:singleLine="true"
        android:textColor="@color/browser_url_text"
        android:textColorHint="@color/browser_url_hint_color"
        android:textSize="12sp" />

    <!-- Log list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/logRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:minHeight="200dp"
        android:scrollbars="vertical" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/logEmptyView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:minHeight="200dp"
        android:text="@string/browser_log_empty"
        android:textColor="@color/browser_url_hint_color"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Action bar: send selected / send all -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/btnSendSelected"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/browser_log_send_selected"
            android:textColor="#58a6ff"
            android:textSize="12sp"
            android:background="@drawable/bg_toolbar_btn"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnSendAll"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginStart="8dp"
            android:text="@string/browser_log_send_all"
            android:textColor="#58a6ff"
            android:textSize="12sp"
            android:background="@drawable/bg_toolbar_btn"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Message input bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/messageInput"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/bg_url_bar"
            android:hint="@string/browser_log_send_message_hint"
            android:imeOptions="actionSend"
            android:inputType="text"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:textColor="@color/browser_url_text"
            android:textColorHint="@color/browser_url_hint_color"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnSendMessage"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginStart="6dp"
            android:text="@string/browser_log_send"
            android:textColor="#58a6ff"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_toolbar_btn"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
